# wrangler >=4.113 richiede @cloudflare/workers-types ^5, @cloudflare/next-on-pages ^4:
# peer inconciliabili, la build su Cloudflare Pages muore con ERESOLVE.
# Il pacchetto in conflitto è di soli tipi TypeScript ed è peer OPZIONALE per entrambi,
# quindi ignorare il conflitto non cambia nulla a runtime.
# Da togliere quando si migra a @opennextjs/cloudflare (next-on-pages è deprecato).
legacy-peer-deps=true
