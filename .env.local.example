# ─── Business contacts ──────────────────────────────────────────────────────
# Numero WhatsApp del business (formato internazionale, senza spazi o +)
# Esempio: 393331234567 per +39 333 123 4567
NEXT_PUBLIC_WHATSAPP_NUMBER=39XXXXXXXXXX

# Numero di telefono visibile (usato anche nei metadati SEO e Schema.org)
# Esempio: +39 031 123 4567
NEXT_PUBLIC_PHONE=+39 031 000 0000

# Email di destinazione per le richieste di prenotazione
NEXT_PUBLIC_BOOKING_EMAIL=info@4mboatlakecomo.com

# ─── Resend (email API) ─────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
PERSONAL_EMAIL=info@4mboatlakecomo.com

# ─── Cloudflare R2 (media storage + CDN) ────────────────────────────────────
# Public CDN URL (custom domain mapped to the R2 bucket).
# Once set, next/image automatically routes through Cloudflare Image
# Transformations. Leave empty to keep serving from /public during dev.
NEXT_PUBLIC_MEDIA_URL=https://media.4mboatlakecomo.com

# R2 credentials — used ONLY by scripts/upload-r2.mjs (never exposed to client)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=4m-media

# ─── Analytics (set after creating accounts) ────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Cloudflare Turnstile (anti-bot sui form) ───────────────────────────────
# Dashboard Cloudflare → Turnstile → Add widget. Copia le due chiavi qui sotto.
# SENZA queste due variabili le API rifiutano ogni invio (fail closed):
# impostale su Cloudflare Pages PRIMA di deployare il codice.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_site_key_qui
TURNSTILE_SECRET_KEY=0x4AAAAAAA_secret_key_qui
